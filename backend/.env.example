#----------------------------------------------------------------------------------------------------------
# Meeting attendance rules (ONLINE ONLY)
#HOST_GRACE_MINUTES = 5 The provider must show up within 5 minutes after the scheduled start. If 5 minutes pass and the host never joined, the meeting is auto-ended and marked host no‑show.
#ATTENDEE_GRACE_MINUTES=5 Once the host has joined, attendees must show up within 5 minutes of the scheduled start. If 5 minutes pass and no attendee has joined, the meeting is auto-ended and marked attendee no‑show.
#MIN_HOST_SECONDS=60 For a meeting to be marked completed, the host must have been in the room for at least 60 seconds total (based on join/leave events).
#MIN_ATTENDEE_SECONDS=60 For completion, at least one attendee must have been in the room for at least 60 seconds total. If that doesn’t happen (even if the host stayed), it is marked attendee no‑show.
HOST_GRACE_MINUTES=5
ATTENDEE_GRACE_MINUTES=5
MIN_HOST_SECONDS=60
MIN_ATTENDEE_SECONDS=60
ONLINE_JOIN_BUFFER_AFTER_END_MINUTES=5


# Slot timezone offset (minutes). Example: 330 for IST, 0 for UTC.
SLOT_TIMEZONE_OFFSET_MINUTES=0
